{
  "name": "group-travel-planner",
  "version": "2.0.0",
  "private": true,
  "description": "Group Travel Planner Application - CPAN 314 Group 3 - Phase 3 Final Prototype",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,magenta npm:dev:server npm:dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "reset": "npm run reset --workspace server",
    "test": "npm test --workspaces --if-present",
    "test:server": "npm test --workspace server",
    "test:client": "npm test --workspace client",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
