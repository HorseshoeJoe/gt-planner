{
  "name": "gtp-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the Group Travel Planner Application (local JSON file storage)",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
